# Supabase (local: values printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email of the single pilot admin. Set once; the app promotes that account on first sign-in.
ADMIN_EMAIL=

# Worker/cron protection: callers of /api/cron/tick must send `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# AI gateway. 'anthropic' needs ANTHROPIC_API_KEY. 'mock' runs deterministic detectors +
# the curated question bank and is clearly labeled in the UI. In production, 'mock' refuses
# to approve chat messages (they go to human review) unless AI_MOCK_ALLOW_IN_PRODUCTION=true.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5   # default for both tasks; effort=low; ~3 s per call measured
# Optional per-task overrides (e.g. claude-haiku-5-5 for questions to cut cost ~10x on that task)
ANTHROPIC_MODEL_MODERATION=
ANTHROPIC_MODEL_QUESTIONS=

# Transactional email for waiting/invitation notices. Unset = logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="Common Ground <noreply@example.com>"

# Custom SMTP for Supabase auth emails (pushed to the hosted project with `npx supabase config push`).
# Any SMTP works; for the pilot a Gmail app password is enough (~500 emails/day).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Common Ground"

# Web Push reminders. Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Signed unsubscribe links in reminder emails. Required in production; any long random string.
# Rotate by moving the old value to REMINDER_UNSUB_SECRET_PREVIOUS until old links have aged out.
REMINDER_UNSUB_SECRET=
REMINDER_UNSUB_SECRET_PREVIOUS=
